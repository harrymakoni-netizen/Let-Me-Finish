# All optional. With none of these set the app runs fully: scripted partner, local-only data.
ANTHROPIC_API_KEY=            # enables the AI partner
LMF_AI_MODEL=claude-opus-5-5  # default; set another Claude model id if you prefer
LMF_AI_EFFORT=low             # low | medium | high
LMF_AI_TURNS_PER_MINUTE=12
LMF_AI_TURNS_PER_DAY=300
LMF_AI_DAILY_TURN_BUDGET=5000 # global ceiling on AI turns per server per day
LMF_AI_MAX_TURNS_PER_SESSION=40
LMF_FEEDBACK_WEBHOOK_URL=     # where "Report a problem" messages are delivered
NEXT_PUBLIC_SUPABASE_URL=     # optional accounts (schema in supabase/migrations)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=          # public address, used for share previews
